#!/bin/bash
PROJECT_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
JAVA_BIN="$(/usr/libexec/java_home -v 21 2>/dev/null)/bin/java"
if [ ! -x "$JAVA_BIN" ]; then /usr/bin/osascript -e 'display alert "Java 21을 찾을 수 없습니다."'; exit 1; fi
if [ ! -d "$PROJECT_DIR/build/local-web/lib" ]; then /usr/bin/osascript -e 'display alert "실행 파일을 찾을 수 없습니다."'; exit 1; fi
cd "$PROJECT_DIR" || exit 1
if ! "$PROJECT_DIR/start-mysql.sh"; then /usr/bin/osascript -e 'display alert "로컬 DB 서버를 시작하지 못했습니다."'; exit 1; fi
exec "$JAVA_BIN" -Dworship.mysql.config="$PROJECT_DIR/.server/mysql.properties" -cp "$PROJECT_DIR/build/local-web/lib/*" org.localchurch.worship.web.LocalWeb "$PROJECT_DIR/local-songs.sqlite3" --open
