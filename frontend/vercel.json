{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "functions": {
    "api/melody.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/auto-melody/jobs",
      "destination": "/api/melody?path=jobs"
    },
    {
      "source": "/auth/me",
      "destination": "/api/proxy?path=/auth/me"
    },
    {
      "source": "/auth/signup",
      "destination": "/api/proxy?path=/auth/signup"
    },
    {
      "source": "/auth/login",
      "destination": "/api/proxy?path=/auth/login"
    },
    {
      "source": "/auth/refresh",
      "destination": "/api/proxy?path=/auth/refresh"
    },
    {
      "source": "/auth/logout",
      "destination": "/api/proxy?path=/auth/logout"
    },
    {
      "source": "/search",
      "destination": "https://yebit-web-test.yjryu.workers.dev/search"
    },
    {
      "source": "/songs",
      "destination": "https://yebit-web-test.yjryu.workers.dev/songs"
    },
    {
      "source": "/song",
      "destination": "https://yebit-web-test.yjryu.workers.dev/song"
    },
    {
      "source": "/ppt-songs",
      "destination": "https://yebit-web-test.yjryu.workers.dev/ppt-songs"
    },
    {
      "source": "/requests",
      "destination": "https://yebit-web-test.yjryu.workers.dev/requests"
    },
    {
      "source": "/ppt/:path*",
      "destination": "https://yebit-web-test.yjryu.workers.dev/ppt/:path*"
    },
    {
      "source": "/ppt",
      "destination": "https://yebit-web-test.yjryu.workers.dev/ppt"
    },
    {
      "source": "/youtube-videos",
      "destination": "https://yebit-web-test.yjryu.workers.dev/youtube-videos"
    },
    {
      "source": "/youtube-thumbnail/:path*",
      "destination": "https://yebit-web-test.yjryu.workers.dev/youtube-thumbnail/:path*"
    },
    {
      "source": "/song-artwork/:path*",
      "destination": "https://yebit-web-test.yjryu.workers.dev/song-artwork/:path*"
    },
    {
      "source": "/local-token.js",
      "destination": "https://yebit-web-test.yjryu.workers.dev/local-token.js"
    }
  ]
}
